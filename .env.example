# Application Settings
PROJECT_NAME="Local Agentic RAG Engine"
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3.2"
EMBEDDING_MODEL="nomic-embed-text"
MILVUS_DB_PATH="./data/milvus_demo.db"
COLLECTION_NAME="rag_knowledge_base"
MAX_RETRIES=2

# gRPC Keepalive & Throttle Prevention (Windows / Milvus Lite)
GRPC_ARG_KEEPALIVE_TIME_MS=300000
GRPC_ARG_KEEPALIVE_TIMEOUT_MS=20000
GRPC_ARG_HTTP2_MAX_PINGS_WITHOUT_DATA=0
GRPC_ARG_KEEPALIVE_PERMIT_WITHOUT_CALLS=0
GRPC_ARG_MIN_RECV_PING_INTERVAL_WITHOUT_DATA_MS=300000
GRPC_VERBOSITY=NONE